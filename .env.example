# Noteim — biến môi trường (chỉ TÊN biến, không có khóa thật)
# Khóa thật đặt trên Vercel (hoặc file .env.local cục bộ, không commit).
# Đặc tả: docs/12-auth-db-group-spec.md §1.1 (auth) và §1.3 (DB).

# --- Đăng nhập Google OAuth (§1.1) ---
# Google Cloud Console → OAuth client (Web):
#   Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bí mật ký JWT phiên: openssl rand -base64 32
AUTH_SECRET=

# URL gốc của app, quyết định cookie Secure (https) hay thường (thử localhost)
# Ví dụ thử máy: http://localhost:3100
NEXTAUTH_URL=

# --- Cơ sở dữ liệu (§1.3) ---
# Supabase Postgres vùng Singapore (ap-southeast-1), qua connection pooler.
# Chỉ máy chủ dùng — KHÔNG đặt NEXT_PUBLIC_* cho khóa nào.
DATABASE_URL=

# --- Chạy migration (bước triển khai) ---
# pnpm db:migrate  (đọc DATABASE_URL từ môi trường)

# --- Thử nghiệm (chỉ máy kiểm thử, không bật trên production) ---
# AUTH_FAKE=1        # nhà cung cấp đăng nhập demo cho e2e, không cần khóa Google
# Chế độ thử nghiệm cũ giữ nguyên (đặc tả B4):
# GAP_CHECK_FREE_DAILY=
# GAP_CHECK_MODEL=
# GAP_CHECK_PROVIDERS=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=
# GAP_CHECK_PROVIDER_TIMEOUT_MS=
# GAP_CHECK_FAKE=
# GAP_CHECK_FAKE_SLOW_MS=

# --- Lưu trữ file Cloudflare R2 (PR 04 — để sẵn tên biến theo §1.5) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
