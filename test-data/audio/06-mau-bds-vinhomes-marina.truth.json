  "segments": [
    {
      "id": "g1",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 1.19,
      "end_sec": 7.79,
      "text": "Dạ em chào chị Lan, cảm ơn chị đã qua văn phòng sáng nay. Hôm nay em muốn hiểu kỹ nhu cầu của gia đình mình trước rồi mới giới thiệu căn.",
      "fixture_start_sec": 0,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g17",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 8.14,
      "end_sec": 13.31,
      "text": "Buổi trao đổi hôm nay chị cứ nói thật nhu cầu và ngân sách, căn nào hợp em gửi thông tin sau, chị không bị ép mua đâu ạ.",
      "fixture_start_sec": 45,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g2",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 13.9,
      "end_sec": 22.31,
      "text": "Ờ... ừ em, nhà chị là bốn người, hai bé đang học cấp 1. Chị cần hai phòng ngủ là đủ, là đủ, quan trọng là gần trường Lê Văn Tám cho bọn trẻ đi bộ được.",
      "fixture_start_sec": 80,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g18",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 22.47,
      "end_sec": 27.63,
      "text": "Nhà chị giờ ở Lê Chân, sáng đưa đón hai bé sang Lê Văn Tám, thì là, chạy xe máy gần hai mươi phút.",
      "fixture_start_sec": 135,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g19",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 27.96,
      "end_sec": 34.79,
      "text": "Bé lớn học lớp ba, bé nhỏ mới mẫu giáo bốn tuổi. Sáng bà nội đưa, chiều chị đón, nên chỗ nào cũng phải gần mới được.",
      "fixture_start_sec": 175,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g20",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 35.04,
      "end_sec": 40.25,
      "text": "Chị nghe chị hàng xóm giới thiệu khu Marina, bảo trường liên cấp nằm ngay trong dự án, học xong chạy xuống nhà là được.",
      "fixture_start_sec": 212,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g21",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 40.58,
      "end_sec": 45.5,
      "text": "Cuối tuần chị cũng muốn có chỗ cho hai bé chạy nhảy, kiểu có công viên nước, có chợ đi bộ mười phút tới nơi.",
      "fixture_start_sec": 252,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g3",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 45.78,
      "end_sec": 50.12,
      "text": "Chị thích tầng trung thôi, à, khoảng tầng 12 đến 20, ban công hướng Đông Nam cho mát.",
      "fixture_start_sec": 290,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g22",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 50.57,
      "end_sec": 57.17,
      "text": "Dạ để em ghi lại cho đúng: hai phòng ngủ, gần trường, tầng trung, ban công hướng Đông Nam. Chị xem có thiếu gì không ạ.",
      "fixture_start_sec": 336,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g23",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 57.48,
      "end_sec": 63.2,
      "text": "Khu Marina đang mở bán tháp B, đúng tầm tiêu chí của mình. Chiều nay em gửi chị mặt bằng và giá từng căn.",
      "fixture_start_sec": 375,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g57",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 63.44,
      "end_sec": 66.45,
      "text": "Mùa này người đi xem đông lắm, căn nào vừa ra là có người giữ ngay.",
      "fixture_start_sec": 422,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g4",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 67.1,
      "end_sec": 71.46,
      "text": "Ngân sách thì là tối đa 4,2 tỷ em ạ. Chị có sẵn khoảng 2,1 tỷ, ừ.",
      "fixture_start_sec": 440,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g24",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 71.68,
      "end_sec": 77.22,
      "text": "Hai phẩy một tỷ đó là chị để dành, để dành ba năm nay đấy em, phần còn lại là đất vay, nên chị tính rất kỹ.",
      "fixture_start_sec": 475,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g5",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 77.58,
      "end_sec": 82.14,
      "text": "Còn lại chị định vay, ừm, vay một nửa, nhưng cần ân hạn nợ gốc ít nhất 12 tháng.",
      "fixture_start_sec": 530,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g25",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 82.65,
      "end_sec": 87.16,
      "text": "Vay một nửa giá trị căn thì tháng đầu chị trả khoảng hai mươi bốn triệu, em tính theo lãi suất ưu đãi đang có.",
      "fixture_start_sec": 572,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g6",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 87.44,
      "end_sec": 92.75,
      "text": "Dạ hiện ngân hàng đối tác đang ưu đãi 6,5% trong 18 tháng đầu, sau đó thả nổi theo lãi cơ sở cộng biên độ.",
      "fixture_start_sec": 620,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g26",
      "speaker_id": "SPK_03",
      "lang": "vi",
      "start_sec": 93.1,
      "end_sec": 99.31,
      "text": "Tôi với chị Lan đi xem ba dự án rồi, bên nào người bán cũng nói dự án mình là nhất. Hôm nay tôi đi cùng để nghe cho khách quan.",
      "fixture_start_sec": 665,
      "gain_db": -5,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "-20Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g7",
      "speaker_id": "SPK_03",
      "lang": "vi",
      "start_sec": 99.61,
      "end_sec": 103.43,
      "text": "Em nghe bên, à, đồng nghiệp nói phí quản lý chỗ này hơi cao so với mặt bằng chung.",
      "fixture_start_sec": 700,
      "gain_db": -5,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "-20Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g27",
      "speaker_id": "SPK_03",
      "lang": "vi",
      "start_sec": 103.71,
      "end_sec": 108.78,
      "text": "Bên dự án khác người ta thu mười hai nghìn một mét, chỗ này nghe nói mười lăm nghìn, chênh nhau cả chục triệu một năm đấy.",
      "fixture_start_sec": 752,
      "gain_db": -5,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "-20Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g28",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 109.38,
      "end_sec": 112.92,
      "text": "Chuyện phí quản lý em ghi nhận ạ, để em kiểm lại hợp đồng dịch vụ cho chính xác.",
      "fixture_start_sec": 790,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g8",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 115.78,
      "end_sec": 118.98,
      "text": "Nói thật là giá này cao hơn bên Imperia khoảng 300 triệu em ạ.",
      "fixture_start_sec": 810,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g29",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 119.25,
      "end_sec": 125.01,
      "text": "Căn mười hai ơi ba tỷ chín trăm năm mươi, rẻ hơn nhưng nhìn ra đường. Chị thấy căn mười tám ơi đáng tiền hơn.",
      "fixture_start_sec": 855,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g9",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 125.19,
      "end_sec": 128.54,
      "text": "Chị lo nhất là sau 18 tháng lãi suất tăng lên thì áp lực trả nợ lớn.",
      "fixture_start_sec": 900,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g30",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 129.02,
      "end_sec": 133.92,
      "text": "Về lãi suất, em sẽ nhờ anh Tuấn bên ngân hàng đối tác tính giúp chị kịch bản xấu nhất, tức sau khi hết ưu đãi.",
      "fixture_start_sec": 945,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g31",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 134.62,
      "end_sec": 139.96,
      "text": "Chị giữ tiền không phải để ăn lãi đâu em, chị giữ để có nhà cho con cháu sau này, nên lần này chị chọn rất kỹ.",
      "fixture_start_sec": 985,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g32",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 140.32,
      "end_sec": 145.14,
      "text": "Nhà chị mua lần trước năm mười hai, lúc đó giấy tờ gì chị cũng đi kiểm tra hết, mất cả tháng mới xong.",
      "fixture_start_sec": 1030,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g33",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 145.36,
      "end_sec": 150.8,
      "text": "Lần này chị có người bạn làm ngành pháp lý nhờ xem giúp, sổ hồng, hợp đồng đặt cọc, phạt vi phạm gì cũng phải rõ ràng.",
      "fixture_start_sec": 1080,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+18%"
      }
    },
    {
      "id": "g10",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 151.36,
      "end_sec": 156.8,
      "text": "Em giới thiệu chị căn 18.06, hai phòng ngủ, 72 mét vuông, ban công đúng hướng Đông Nam chị muốn.",
      "fixture_start_sec": 1140,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g34",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 157.16,
      "end_sec": 162.53,
      "text": "Giá căn mười tám ơ sáu là bốn phẩy mười lăm tỷ, đã gồm thuế và nội thất cơ bản, chốt được em làm thủ tục ngay.",
      "fixture_start_sec": 1198,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g35",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 162.85,
      "end_sec": 167.53,
      "text": "Tháp B bàn giao quý hai năm sau, chủ đầu tư bên này giao đúng hạn ba năm nay rồi, chị cứ yên tâm.",
      "fixture_start_sec": 1245,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g36",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 167.89,
      "end_sec": 172.75,
      "text": "Nhà bếp tách riêng, phòng ngủ master có nhà vệ sinh riêng, phòng khách cửa kính trọn, chị thích kiểu đó không ạ.",
      "fixture_start_sec": 1295,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g37",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 173.05,
      "end_sec": 176.6,
      "text": "Anh chị mai thu xếp qua xem nhà mẫu với em nhé, đứng trong căn mới cảm nhận hết được.",
      "fixture_start_sec": 1340,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g11",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 177.16,
      "end_sec": 180.37,
      "text": "Bếp tách riêng chị thích. Có điều phòng ngủ phụ hơi nhỏ.",
      "fixture_start_sec": 1370,
      "gain_db": -3,
      "voice": {
