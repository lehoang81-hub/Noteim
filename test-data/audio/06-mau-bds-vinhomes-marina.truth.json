        "rate": "+18%"
      }
    },
    {
      "id": "g58",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 180.83,
      "end_sec": 183.21,
      "text": "Chị để ý giúp em chỗ để xe với trạm sạc xe điện nhé.",
      "fixture_start_sec": 1462,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
