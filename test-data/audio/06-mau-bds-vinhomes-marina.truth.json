    },
    {
      "id": "g38",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 183.68,
      "end_sec": 188.77,
      "text": "Phòng khách kính trọn thì sáng quá, chị chỉ sợ nắng trưa. Để mai chị xem tận nơi rồi tính.",
      "fixture_start_sec": 1485,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
