    {
      "id": "s15",
      "speaker_id": "SPK_04",
      "lang": "vi",
      "start_sec": 117.79,
      "end_sec": 122.72,
      "text": "Còn phương án C có đáng quan tâm không? Nghe nói chu kỳ ép nhanh hơn hẳn.",
