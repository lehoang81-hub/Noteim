    {
      "id": "s12",
      "speaker_id": "SPK_03",
      "lang": "en",
      "start_sec": 95.07,
      "end_sec": 103.61,
      "text": "Option B uses S136 stainless steel with a lifetime of about 500,000 shots, so the surface stays glossy much longer.",
      "fixture_start_sec": 428,
      "gain_db": -4,
      "voice": {
        "engine": "edge",
