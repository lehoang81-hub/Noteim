      "gain_db": -4,
      "voice": {
        "engine": "edge",
        "voice": "ko-KR-SunHiNeural",
        "pitch": "+8Hz",
        "rate": "+5%"
      }
    },
    {
      "id": "s10",
      "speaker_id": "SPK_04",
      "lang": "vi",
      "start_sec": 77.06,
      "end_sec": 83.42,
      "text": "Thép P20 chịu được chi tiết hộc tủ thành mỏng không? Chúng tôi lo độ bóng bề mặt sau 200.000 lần ép.",
      "fixture_start_sec": 334,
      "gain_db": -6,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+10Hz",
        "rate": "+0%"
