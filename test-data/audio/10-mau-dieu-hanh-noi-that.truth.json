    {
      "id": "g27",
      "speaker_id": "SPK_03",
      "lang": "vi",
      "start_sec": 103.55,
      "end_sec": 107.73,
      "text": "Đơn Hoàng Huy Commerce giao ngày hai mươi tháng mười hai, trễ là mất khách bên đó luôn, họ dặn trước rồi.",
      "fixture_start_sec": 1650,
