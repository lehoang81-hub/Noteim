      "id": "g6",
      "speaker_id": "SPK_04",
      "lang": "vi",
      "start_sec": 124.43,
      "end_sec": 127.85,
      "text": "Em đề xuất gói Đón Tết nhà mới, giảm 7% cho đơn trên 50 triệu.",
