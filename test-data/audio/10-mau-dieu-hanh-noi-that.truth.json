  "segments": [
    {
      "id": "g1",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 1.19,
      "end_sec": 7.08,
      "text": "Mình bắt đầu nhé. Hôm nay có bốn việc: số liệu tháng 10, nhà cung cấp gỗ, tình hình xưởng và kế hoạch Tết.",
      "fixture_start_sec": 0,
