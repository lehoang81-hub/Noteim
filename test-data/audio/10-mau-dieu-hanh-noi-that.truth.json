      "id": "g31",
      "speaker_id": "SPK_03",
      "lang": "vi",
      "start_sec": 118.43,
      "end_sec": 122.19,
      "text": "Có thêm ca tối là em cam kết đơn tháng mười hai giữ trọn, trễ một đơn em chịu trách nhiệm.",
      "fixture_start_sec": 1890,
      "gain_db": -5,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "-15Hz",
        "rate": "+25%"
      }
    },
    {
      "id": "g32",
      "speaker_id": "SPK_04",
      "lang": "vi",
      "start_sec": 122.6,
