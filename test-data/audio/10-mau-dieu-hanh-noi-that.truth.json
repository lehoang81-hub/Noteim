    },
    {
      "id": "g21",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 72.94,
      "end_sec": 76.52,
      "text": "Chất lượng họ gửi mẫu cắt thử rồi, về cơ bản đạt, em với trưởng xưởng đều gật.",
      "fixture_start_sec": 1275,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g22",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 76.8,
      "end_sec": 80.96,
      "text": "Mình ký hợp đồng thử ba tháng, tháng mười hai chạy song song hai bên, ai rớt chất lượng thì dừng.",
      "fixture_start_sec": 1320,
