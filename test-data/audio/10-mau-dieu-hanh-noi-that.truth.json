      }
    },
    {
      "id": "g11",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 7.43,
      "end_sec": 12.02,
      "text": "Mình có đúng sáu mươi tám phút, ai phát biểu ngắn gọn giúp, việc nào vướng thì nói thẳng, đừng nói vòng.",
      "fixture_start_sec": 50,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g12",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 12.35,
      "end_sec": 19.52,
      "text": "Chương trình hôm nay: số liệu tháng mười, chuyện nhà cung cấp gỗ, tình hình xưởng, và chiến dịch Tết. Bắt đầu là số liệu, Thảo trình bày.",
      "fixture_start_sec": 110,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g2",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 19.85,
      "end_sec": 23.38,
      "text": "Doanh thu tháng 10 là 3,8 tỷ, tăng 12% so với tháng 9.",
      "fixture_start_sec": 630,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g13",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 23.71,
      "end_sec": 27.92,
      "text": "Doanh thu mảng nội thất văn phòng chiếm năm mươi lăm phần trăm, lần đầu tiên vượt mảng nội thất gia đình.",
      "fixture_start_sec": 700,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g14",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 28.17,
      "end_sec": 34.1,
      "text": "Bộ phận thiết kế ký chín hợp đồng mới, cao nhất từ đầu năm. Khách doanh nghiệp quay lại đặt đơn lần hai có bốn bên.",
      "fixture_start_sec": 775,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g15",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 34.43,
      "end_sec": 40.89,
      "text": "Chi nguyên vật liệu tăng sáu phần trăm, chủ yếu do giá gỗ tự nhiên lên. May là mình chốt giá bán từ quý trước nên kịp điều chỉnh.",
      "fixture_start_sec": 845,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g16",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 41.18,
      "end_sec": 44.49,
      "text": "Lợi nhuận gộp vẫn giữ hai tám phần trăm, mình chấp nhận được với mùa này.",
      "fixture_start_sec": 915,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g3",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 44.73,
      "end_sec": 48.62,
      "text": "Công nợ quá 60 ngày còn 620 triệu, chủ yếu ở hai công trình bên Kiến An.",
      "fixture_start_sec": 970,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g17",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 48.93,
      "end_sec": 55.17,
      "text": "Sáu trăm hai mươi triệu công nợ quá sáu mươi ngày, phần lớn là hai công trình bên Kiến An. Em đã gửi thư nhắc hai lượt rồi.",
      "fixture_start_sec": 1020,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g18",
      "speaker_id": "SPK_02",
      "lang": "vi",
      "start_sec": 55.41,
      "end_sec": 60.04,
      "text": "Em đề xuất từ tháng mười hai dừng nhận đơn của khách có lịch sử chậm trả, ai muốn nhận thì anh Minh duyệt lại.",
      "fixture_start_sec": 1085,
      "gain_db": -3,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-HoaiMyNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g19",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 60.7,
      "end_sec": 63.94,
      "text": "Phần gỗ, anh Đức với em đã nói chuyện sơ trước họp, giờ chốt luôn.",
      "fixture_start_sec": 1145,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g4",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 64.16,
      "end_sec": 67.81,
      "text": "Anh chốt chuyển sang gỗ An Phát từ tháng 12, giá họ thấp hơn 8%.",
      "fixture_start_sec": 1170,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
      }
    },
    {
      "id": "g20",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 68.16,
      "end_sec": 72.67,
      "text": "Giá bên An Phát thấp hơn nhà cung cấp đang dùng tám phần trăm, cùng loại dầm bo, cùng keo dán.",
      "fixture_start_sec": 1220,
      "gain_db": 0,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "+0Hz",
        "rate": "+20%"
