    },
    {
      "id": "g24",
      "speaker_id": "SPK_03",
      "lang": "vi",
      "start_sec": 85.21,
      "end_sec": 89.58,
      "text": "Bên xưởng em báo thẳng: tháng mười hai mình nhận ba mươi mốt đơn, mà công suất cho phép mới hai mươi bảy.",
