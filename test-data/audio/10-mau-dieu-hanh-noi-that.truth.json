    },
    {
      "id": "g23",
      "speaker_id": "SPK_01",
      "lang": "vi",
      "start_sec": 81.14,
      "end_sec": 84.68,
      "text": "Ai có ý kiến gì về nhà cung cấp thì nói ngay hôm nay, đừng để ký rồi mới nói.",
      "fixture_start_sec": 1365,
