        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "-15Hz",
        "rate": "+25%"
      }
    },
    {
      "id": "g25",
      "speaker_id": "SPK_03",
      "lang": "vi",
      "start_sec": 89.87,
      "end_sec": 93.77,
      "text": "Xưởng đang chạy một trăm mười lăm phần trăm công suất, ba đơn có nguy cơ trễ hạn nếu không thay đổi gì.",
      "fixture_start_sec": 1495,
      "gain_db": -5,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "-15Hz",
