    {
      "id": "g28",
      "speaker_id": "SPK_03",
      "lang": "vi",
      "start_sec": 107.91,
      "end_sec": 111.26,
      "text": "Em cần thêm bốn thợ thời vụ, làm sáu tuần, được thì gánh được ca tối.",
      "fixture_start_sec": 1705,
      "gain_db": -5,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "-15Hz",
        "rate": "+25%"
