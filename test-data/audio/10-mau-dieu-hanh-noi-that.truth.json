      "id": "g35",
      "speaker_id": "SPK_04",
      "lang": "vi",
      "start_sec": 136.91,
      "end_sec": 140.01,
      "text": "Hình ảnh em đổi sang ảnh công trình thật, không dùng ảnh mẫu trên mạng nữa.",
