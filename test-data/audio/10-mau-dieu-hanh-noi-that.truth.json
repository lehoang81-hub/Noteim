      "id": "g30",
      "speaker_id": "SPK_03",
      "lang": "vi",
      "start_sec": 115.44,
      "end_sec": 118.07,
      "text": "Tuyển người chính thức thì không kịp, thời vụ chỉ thuê ngoài được thôi.",
      "fixture_start_sec": 1840,
      "gain_db": -5,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "-15Hz",
