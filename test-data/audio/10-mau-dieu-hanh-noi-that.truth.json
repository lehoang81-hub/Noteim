    },
    {
      "id": "g26",
      "speaker_id": "SPK_03",
      "lang": "vi",
      "start_sec": 94.11,
      "end_sec": 98.05,
      "text": "Bốn thợ chính thì hai người nghỉ việc, người thay vào tay nghề chưa đều, khâu dầm bo là chậm nhất.",
      "fixture_start_sec": 1550,
      "gain_db": -5,
      "voice": {
        "engine": "edge",
        "voice": "vi-VN-NamMinhNeural",
        "pitch": "-15Hz",
