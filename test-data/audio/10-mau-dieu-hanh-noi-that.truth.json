    },
    {
      "id": "g5",
      "speaker_id": "SPK_03",
      "lang": "vi",
      "start_sec": 100.91,
      "end_sec": 103.29,
      "text": "Nếu không thêm ca tối thì đơn Hoàng Huy chắc chắn trễ.",
      "fixture_start_sec": 1600,
      "gain_db": -5,
      "voice": {
        "engine": "edge",
