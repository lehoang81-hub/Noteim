    },
    {
      "id": "g38",
      "speaker_id": "SPK_04",
      "lang": "vi",
      "start_sec": 148.63,
      "end_sec": 152.62,
      "text": "Em cần danh sách khách cũ từ bộ phận bán hàng để gọi mời, cả khách đã nhận nhà lẫn khách hủy.",
