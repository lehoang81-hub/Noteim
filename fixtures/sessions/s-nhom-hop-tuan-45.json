        "bullets": [
          {
            "id": "b3",
            "text": "Căn Marina C anh Hoàng đang chốt 4,68 tỷ, nếu ký được thì tuần này vượt kế hoạch.",
            "timestamp_sec": 700,
            "speaker_id": "SPK_01",
            "is_quote": false,
            "edited": false,
            "note_ids": []
          },
          {
            "id": "b4",
            "text": "Khách thuê văn phòng Sông Hồng muốn giảm giá 8%, anh Hùng đề xuất giảm 5% kèm ba tháng miễn phí quản lý.",
            "timestamp_sec": 920,
            "speaker_id": "SPK_04",
            "is_quote": false,
            "edited": false,
            "note_ids": []
          },
          {
            "id": "b5",
            "text": "Căn 12A Hoàng Huy bên bán muốn chốt nhanh trước 20/11, Mai Anh lo phần thẩm định pháp lý.",
