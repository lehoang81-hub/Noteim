  "transcript": [
    {
      "id": "t1",
      "speaker_id": "SPK_01",
      "start_sec": 0,
      "end_sec": 300,
      "text": "Dạ em chào chị Nhàn, chiều nay mình xem lại đúng căn tầng 14 tòa The Legend Hà Phong nhé. Căn này 120 mét vuông, view thành phố, chủ tòa đang để giá chào 380.000 một mét vuông một tháng.",
      "lang": "vi",
      "translations": {},
      "edited": false
    },
    {
      "id": "t2",
      "speaker_id": "SPK_02",
      "start_sec": 300,
      "end_sec": 560,
      "text": "Bên tôi cần đúng 120 mét vuông cho 18 nhân viên, chia ba phòng riêng và một khu vực mở. Văn phòng phải nhận nhà từ đầu tháng 1 năm 2027, hợp đồng ký hai năm.",
      "lang": "vi",
      "translations": {},
      "edited": false
    },
    {
      "id": "t3",
      "speaker_id": "SPK_01",
      "start_sec": 560,
      "end_sec": 820,
      "text": "Căn tầng 14 còn nguyên, chủ tòa cho sửa mặt bằng trước khi nhận. Giá chào chưa gồm phí quản lý 22.000 một mét vuông một tháng và ba chỗ đậu ô tô tính thêm 1,5 triệu mỗi tháng.",
      "lang": "vi",
      "translations": {},
      "edited": false
    },
    {
      "id": "t4",
      "speaker_id": "SPK_02",
      "start_sec": 820,
      "end_sec": 1000,
      "text": "Phí đậu xe thì bên tôi chấp nhận được. Nhưng giá thuê 380.000 cao hơn mặt bằng khu đó, tôi chỉ ký khi giá về mức 350.000.",
      "lang": "vi",
      "translations": {},
      "edited": false
    },
    {
      "id": "t5",
      "speaker_id": "SPK_01",
      "start_sec": 1000,
      "end_sec": 1300,
      "text": "Em sẽ đàm phán lại với chủ tòa theo phương án giảm 5% còn 361.000, kèm ba tháng miễn phí quản lý. Với hợp đồng hai năm thì chủ tòa dễ đồng ý phương án này hơn là cắt sâu giá một lần.",
      "lang": "vi",
      "translations": {},
      "edited": false
    },
    {
      "id": "t6",
      "speaker_id": "SPK_02",
      "start_sec": 1300,
      "end_sec": 1480,
      "text": "Giá về 361.000 kèm miễn phí quản lý thì ổn. Khi ký tôi đặt cọc hai tháng tiền thuê, nhưng chờ phương án giá cuối cùng của chủ tòa đã, cuối tuần tôi trả lời.",
      "lang": "vi",
      "translations": {},
      "edited": false
    },
    {
      "id": "t7",
      "speaker_id": "SPK_01",
      "start_sec": 1480,
      "end_sec": 1600,
      "text": "Vâng, em gửi phương án giá chính thức cho chị trước chiều thứ Sáu.",
      "lang": "vi",
      "translations": {},
      "edited": false
