    "section_id": "tpl-business-s1",
    "title": "Chốt nhà cung cấp gỗ mới",
    "start_sec": 1140,
    "end_sec": 1440,
    "tag": "decided",
    "bullets": [
     {
      "id": "c4",
      "text": "Chuyển sang nhà cung cấp gỗ An Phát từ tháng 12, giá thấp hơn 8%",
      "timestamp_sec": 1180,
      "speaker_id": "SPK_01",
      "is_quote": false,
      "edited": false,
      "note_ids": []
     },
     {
      "id": "c5",
      "text": "Ký hợp đồng thử 3 tháng trước khi cam kết cả năm",
