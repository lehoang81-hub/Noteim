 "transcript": [
  {
   "id": "g1",
   "speaker_id": "SPK_01",
   "start_sec": 0,
   "end_sec": 40,
   "text": "Mình bắt đầu nhé. Hôm nay có bốn việc: số liệu tháng 10, nhà cung cấp gỗ, tình hình xưởng và kế hoạch Tết.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g11",
   "speaker_id": "SPK_01",
   "start_sec": 50,
   "end_sec": 95,
   "text": "Mình có đúng sáu mươi tám phút, ai phát biểu ngắn gọn giúp, việc nào vướng thì nói thẳng, đừng nói vòng.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g12",
   "speaker_id": "SPK_01",
   "start_sec": 110,
   "end_sec": 165,
   "text": "Chương trình hôm nay: số liệu tháng mười, chuyện nhà cung cấp gỗ, tình hình xưởng, và chiến dịch Tết. Bắt đầu là số liệu, Thảo trình bày.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g2",
   "speaker_id": "SPK_02",
   "start_sec": 630,
   "end_sec": 680,
   "text": "Doanh thu tháng 10 là 3,8 tỷ, tăng 12% so với tháng 9.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g13",
   "speaker_id": "SPK_02",
   "start_sec": 700,
   "end_sec": 760,
   "text": "Doanh thu mảng nội thất văn phòng chiếm năm mươi lăm phần trăm, lần đầu tiên vượt mảng nội thất gia đình.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g14",
   "speaker_id": "SPK_02",
   "start_sec": 775,
   "end_sec": 830,
   "text": "Bộ phận thiết kế ký chín hợp đồng mới, cao nhất từ đầu năm. Khách doanh nghiệp quay lại đặt đơn lần hai có bốn bên.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g15",
   "speaker_id": "SPK_02",
   "start_sec": 845,
   "end_sec": 905,
   "text": "Chi nguyên vật liệu tăng sáu phần trăm, chủ yếu do giá gỗ tự nhiên lên. May là mình chốt giá bán từ quý trước nên kịp điều chỉnh.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g16",
   "speaker_id": "SPK_02",
   "start_sec": 915,
   "end_sec": 960,
   "text": "Lợi nhuận gộp vẫn giữ hai tám phần trăm, mình chấp nhận được với mùa này.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g3",
   "speaker_id": "SPK_02",
   "start_sec": 970,
   "end_sec": 1010,
   "text": "Công nợ quá 60 ngày còn 620 triệu, chủ yếu ở hai công trình bên Kiến An.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g17",
   "speaker_id": "SPK_02",
   "start_sec": 1020,
   "end_sec": 1075,
   "text": "Sáu trăm hai mươi triệu công nợ quá sáu mươi ngày, phần lớn là hai công trình bên Kiến An. Em đã gửi thư nhắc hai lượt rồi.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g18",
   "speaker_id": "SPK_02",
   "start_sec": 1085,
   "end_sec": 1135,
   "text": "Em đề xuất từ tháng mười hai dừng nhận đơn của khách có lịch sử chậm trả, ai muốn nhận thì anh Minh duyệt lại.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g19",
   "speaker_id": "SPK_01",
   "start_sec": 1145,
   "end_sec": 1165,
   "text": "Phần gỗ, anh Đức với em đã nói chuyện sơ trước họp, giờ chốt luôn.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g4",
   "speaker_id": "SPK_01",
   "start_sec": 1170,
   "end_sec": 1210,
   "text": "Anh chốt chuyển sang gỗ An Phát từ tháng 12, giá họ thấp hơn 8%.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g20",
   "speaker_id": "SPK_01",
   "start_sec": 1220,
   "end_sec": 1265,
   "text": "Giá bên An Phát thấp hơn nhà cung cấp đang dùng tám phần trăm, cùng loại dầm bo, cùng keo dán.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g21",
   "speaker_id": "SPK_01",
   "start_sec": 1275,
   "end_sec": 1310,
   "text": "Chất lượng họ gửi mẫu cắt thử rồi, về cơ bản đạt, em với trưởng xưởng đều gật.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g22",
   "speaker_id": "SPK_01",
   "start_sec": 1320,
   "end_sec": 1355,
   "text": "Mình ký hợp đồng thử ba tháng, tháng mười hai chạy song song hai bên, ai rớt chất lượng thì dừng.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g23",
   "speaker_id": "SPK_01",
   "start_sec": 1365,
   "end_sec": 1400,
   "text": "Ai có ý kiến gì về nhà cung cấp thì nói ngay hôm nay, đừng để ký rồi mới nói.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g24",
   "speaker_id": "SPK_03",
   "start_sec": 1450,
   "end_sec": 1492,
   "text": "Bên xưởng em báo thẳng: tháng mười hai mình nhận ba mươi mốt đơn, mà công suất cho phép mới hai mươi bảy.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g25",
   "speaker_id": "SPK_03",
   "start_sec": 1495,
   "end_sec": 1540,
   "text": "Xưởng đang chạy một trăm mười lăm phần trăm công suất, ba đơn có nguy cơ trễ hạn nếu không thay đổi gì.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g26",
   "speaker_id": "SPK_03",
   "start_sec": 1550,
   "end_sec": 1595,
   "text": "Bốn thợ chính thì hai người nghỉ việc, người thay vào tay nghề chưa đều, khâu dầm bo là chậm nhất.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g5",
   "speaker_id": "SPK_03",
   "start_sec": 1600,
   "end_sec": 1640,
   "text": "Nếu không thêm ca tối thì đơn Hoàng Huy chắc chắn trễ.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g27",
   "speaker_id": "SPK_03",
   "start_sec": 1650,
   "end_sec": 1695,
   "text": "Đơn Hoàng Huy Commerce giao ngày hai mươi tháng mười hai, trễ là mất khách bên đó luôn, họ dặn trước rồi.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g28",
   "speaker_id": "SPK_03",
   "start_sec": 1705,
   "end_sec": 1750,
   "text": "Em cần thêm bốn thợ thời vụ, làm sáu tuần, được thì gánh được ca tối.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g29",
   "speaker_id": "SPK_03",
   "start_sec": 1795,
   "end_sec": 1830,
   "text": "Chi phí ước khoảng sáu mươi triệu, so với bị phạt hợp đồng và mất khách thì rẻ hơn nhiều.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g30",
   "speaker_id": "SPK_03",
   "start_sec": 1840,
   "end_sec": 1880,
   "text": "Tuyển người chính thức thì không kịp, thời vụ chỉ thuê ngoài được thôi.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g31",
   "speaker_id": "SPK_03",
   "start_sec": 1890,
   "end_sec": 1935,
   "text": "Có thêm ca tối là em cam kết đơn tháng mười hai giữ trọn, trễ một đơn em chịu trách nhiệm.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g32",
   "speaker_id": "SPK_04",
   "start_sec": 1950,
   "end_sec": 1975,
   "text": "Đến phần em, chiến dịch Tết.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g6",
   "speaker_id": "SPK_04",
   "start_sec": 1980,
   "end_sec": 2020,
   "text": "Em đề xuất gói Đón Tết nhà mới, giảm 7% cho đơn trên 50 triệu.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g33",
   "speaker_id": "SPK_04",
   "start_sec": 2030,
   "end_sec": 2070,
   "text": "Giảm bảy phần trăm cho đơn trên năm mươi triệu, dự kiến doanh thu mùa Tết tăng hai mươi phần trăm.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g34",
   "speaker_id": "SPK_04",
   "start_sec": 2080,
   "end_sec": 2120,
   "text": "Ngân sách quảng cáo em cần thêm tám mươi triệu cho đợt này, riêng video thì quay nội bộ là được.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g35",
   "speaker_id": "SPK_04",
   "start_sec": 2130,
   "end_sec": 2160,
   "text": "Hình ảnh em đổi sang ảnh công trình thật, không dùng ảnh mẫu trên mạng nữa.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g36",
   "speaker_id": "SPK_04",
   "start_sec": 2165,
   "end_sec": 2200,
   "text": "Em quay video ba khách nhận nhà cũ làm chuỗi nội dung, khách tin người thật kể hơn.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g37",
   "speaker_id": "SPK_04",
   "start_sec": 2210,
   "end_sec": 2245,
   "text": "Chạy từ mùng một tháng mười hai, dồn dập hai tuần cuối tháng vì đó là lúc khách bắt đầu đóng tiền.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g38",
   "speaker_id": "SPK_04",
   "start_sec": 2255,
   "end_sec": 2290,
   "text": "Em cần danh sách khách cũ từ bộ phận bán hàng để gọi mời, cả khách đã nhận nhà lẫn khách hủy.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g39",
   "speaker_id": "SPK_01",
   "start_sec": 2365,
   "end_sec": 2400,
   "text": "Chiến dịch em duyệt về nguyên tắc, còn ngân sách thì chị Hà lập bảng chi tiết anh ký.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g40",
   "speaker_id": "SPK_01",
   "start_sec": 2410,
   "end_sec": 2445,
   "text": "Nhân sự: bên thiết kế mình thiếu người rồi, việc mới về liên tục.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g41",
   "speaker_id": "SPK_01",
   "start_sec": 2450,
   "end_sec": 2485,
   "text": "Cần thêm một kiến trúc sư nội thất, mức lương để bộ phận đề xuất, anh không chốt ngay hôm nay.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g42",
   "speaker_id": "SPK_01",
   "start_sec": 2495,
   "end_sec": 2530,
   "text": "Đăng tuyển từ tuần sau, em với anh Đức cùng phỏng vấn cho nhanh.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g43",
   "speaker_id": "SPK_03",
   "start_sec": 2625,
   "end_sec": 2665,
   "text": "Phòng thiết kế mình đang có ba người, một bạn sắp nghỉ sinh quý một năm sau.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g44",
   "speaker_id": "SPK_03",
   "start_sec": 2670,
   "end_sec": 2710,
   "text": "Em tính hai phương án: tuyển chính thức, hoặc thuê theo dự án từng hợp đồng.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g45",
   "speaker_id": "SPK_03",
   "start_sec": 2715,
   "end_sec": 2755,
   "text": "Thuê theo dự án thì nhanh nhưng đắt hơn, mà người lạ không nắm phong cách vẽ của mình.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g46",
   "speaker_id": "SPK_03",
   "start_sec": 2760,
   "end_sec": 2800,
   "text": "Em nghiêng về tuyển chính thức một người, chỗ thiếu đột xuất thì thuê ngoài.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g47",
   "speaker_id": "SPK_03",
   "start_sec": 2805,
   "end_sec": 2845,
   "text": "Tuần sau em gửi bảng so sánh chi phí hai phương án cho anh xem rồi họp chốt.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g48",
   "speaker_id": "SPK_05",
   "start_sec": 2852,
   "end_sec": 2868,
   "text": "Em xin ba phút báo phần bán hàng.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g7",
   "speaker_id": "SPK_05",
   "start_sec": 2870,
   "end_sec": 2910,
   "text": "Tháng này em gặp 14 khách, chốt được 3 hợp đồng.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g49",
   "speaker_id": "SPK_05",
   "start_sec": 2915,
   "end_sec": 2955,
   "text": "Ba hợp đồng chốt đều là nội thất trọn gói, giá trung bình ba trăm tám mươi triệu một công trình.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g50",
   "speaker_id": "SPK_05",
   "start_sec": 2960,
   "end_sec": 3000,
   "text": "Khách chủ yếu đến từ giới thiệu của khách cũ, hai trên ba hợp đồng là vậy.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g51",
   "speaker_id": "SPK_05",
   "start_sec": 3008,
   "end_sec": 3048,
   "text": "Quảng cáo mạng xã hội em chạy bốn mươi lăm triệu cả tháng nhưng chỉ ra một đơn nhỏ.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g52",
   "speaker_id": "SPK_05",
   "start_sec": 3052,
   "end_sec": 3095,
   "text": "Tỷ lệ chốt của khách giới thiệu cao gấp đôi khách từ quảng cáo, con số ba tháng liền như vậy.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g53",
   "speaker_id": "SPK_05",
   "start_sec": 3105,
   "end_sec": 3150,
   "text": "Em đề xuất chi quảng cáo giảm còn ba mươi triệu, phần tiền dư chuyển sang chăm khách cũ.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g54",
   "speaker_id": "SPK_05",
   "start_sec": 3155,
   "end_sec": 3195,
   "text": "Mỗi khách cũ em đề xuất tặng gói bảo trì năm đầu, chi khoảng hai triệu nhưng giữ được khách.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g55",
   "speaker_id": "SPK_05",
   "start_sec": 3200,
   "end_sec": 3245,
   "text": "Danh sách khách cũ em xin nhận từ chị Hà trước ngày hai mươi lăm để kịp gọi.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g56",
   "speaker_id": "SPK_04",
   "start_sec": 3255,
   "end_sec": 3295,
   "text": "Phần em, chiến dịch Tết em đã gửi nhóm chat sáng nay, ai xem qua cho ý kiến.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g57",
   "speaker_id": "SPK_04",
   "start_sec": 3300,
   "end_sec": 3340,
   "text": "Kế hoạch cần tám mươi triệu ngân sách, em xin anh duyệt trước ngày hai mươi.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g58",
   "speaker_id": "SPK_04",
   "start_sec": 3345,
   "end_sec": 3395,
   "text": "Nếu duyệt chậm hơn thì đợt quảng cáo đầu tháng mười hai bị trễ, mất đúng tuần khách bắt đầu chi tiền.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g59",
   "speaker_id": "SPK_02",
   "start_sec": 3405,
   "end_sec": 3435,
   "text": "Phần công nợ em xin nói gọn cuối cùng.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g8",
   "speaker_id": "SPK_02",
   "start_sec": 3440,
   "end_sec": 3480,
   "text": "Chị gửi mọi người danh sách trong thứ Bảy.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g60",
   "speaker_id": "SPK_02",
   "start_sec": 3490,
   "end_sec": 3530,
   "text": "Danh sách công nợ em gửi từng phụ trách công trình trong thứ Bảy này.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g61",
   "speaker_id": "SPK_02",
   "start_sec": 3540,
   "end_sec": 3580,
   "text": "Công trình Kiến An em đề xuất dừng thi công phần bổ sung cho đến khi thu được tiền.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g62",
   "speaker_id": "SPK_02",
   "start_sec": 3590,
   "end_sec": 3630,
   "text": "Hai công trình còn lại em đôn đốc thu trước ba mươi tháng mười một.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g63",
   "speaker_id": "SPK_02",
   "start_sec": 3640,
   "end_sec": 3680,
   "text": "Quá ngày đó mà chưa xong, em báo anh Minh đưa vào biên bản để anh xử lý với khách.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g64",
   "speaker_id": "SPK_02",
   "start_sec": 3690,
   "end_sec": 3735,
   "text": "Em cũng rà lại hạn mức tín dụng quý một để chuẩn bị tiền mua gỗ đợt Tết.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g65",
   "speaker_id": "SPK_01",
   "start_sec": 3765,
   "end_sec": 3788,
   "text": "Nghe rõ chưa nào, giờ chốt việc từng người.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g9",
   "speaker_id": "SPK_01",
   "start_sec": 3790,
   "end_sec": 3830,
   "text": "Thứ Hai anh Đức phải có kế hoạch ca tối.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g66",
   "speaker_id": "SPK_01",
   "start_sec": 3840,
   "end_sec": 3875,
   "text": "Việc nào ai nhận thì ghi ngay vào biên bản, đừng để ra khỏi phòng lại quên.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g67",
   "speaker_id": "SPK_01",
   "start_sec": 3885,
   "end_sec": 3925,
   "text": "Tình hình xưởng là ưu tiên số một, anh Đức chủ trì và báo anh hàng ngày.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g10",
   "speaker_id": "SPK_01",
   "start_sec": 3940,
   "end_sec": 3980,
   "text": "Hà gửi bản nháp trước 20 nhé.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g68",
   "speaker_id": "SPK_01",
   "start_sec": 3990,
   "end_sec": 4030,
   "text": "Họp tuần sau vẫn giờ cũ, ai vướng phát sinh thì báo trước cho thư ký.",
   "lang": "vi",
   "translations": {},
   "edited": false
  },
  {
   "id": "g69",
   "speaker_id": "SPK_01",
   "start_sec": 4035,
   "end_sec": 4075,
   "text": "Cảm ơn mọi người, mình kết thúc ở đây.",
   "lang": "vi",
   "translations": {},
   "edited": false
  }
