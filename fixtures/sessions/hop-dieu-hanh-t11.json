    "end_sec": 1940,
    "tag": "risk",
    "bullets": [
     {
      "id": "c6",
      "text": "Xưởng đang chạy 115% công suất, 3 đơn có nguy cơ trễ hạn",
      "timestamp_sec": 1500,
      "speaker_id": "SPK_03",
      "is_quote": false,
      "edited": false,
      "note_ids": []
     },
     {
      "id": "c7",
      "text": "\"Nếu không thêm ca tối thì đơn Hoàng Huy chắc chắn trễ\"",
