    "bullets": [
     {
      "id": "c1",
      "text": "Doanh thu tháng 10 đạt 3,8 tỷ, tăng 12% so với tháng 9",
      "timestamp_sec": 640,
      "speaker_id": "SPK_02",
      "is_quote": false,
      "edited": false,
      "note_ids": []
     },
     {
      "id": "c2",
      "text": "Mảng nội thất văn phòng chiếm 55%, lần đầu vượt nội thất gia đình",
      "timestamp_sec": 760,
      "speaker_id": "SPK_02",
      "is_quote": false,
      "edited": false,
      "note_ids": []
     },
     {
      "id": "c3",
      "text": "Công nợ quá 60 ngày còn 620 triệu, chủ yếu từ hai công trình",
      "timestamp_sec": 980,
      "speaker_id": "SPK_02",
      "is_quote": false,
      "edited": false,
      "note_ids": []
     }
    ],
