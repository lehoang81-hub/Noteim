  "transcript": [
    {
      "id": "g1",
      "speaker_id": "SPK_01",
      "start_sec": 0,
      "end_sec": 40,
      "text": "Dạ em chào chị Lan, cảm ơn chị đã qua văn phòng sáng nay. Hôm nay em muốn hiểu kỹ nhu cầu của gia đình mình trước rồi mới giới thiệu căn."
    },
    {
      "id": "g2",
      "speaker_id": "SPK_02",
      "start_sec": 80,
      "end_sec": 130,
      "text": "Ừ em, nhà chị bốn người, hai bé đang học cấp 1. Chị cần hai phòng ngủ là đủ, quan trọng là gần trường Lê Văn Tám cho bọn trẻ đi bộ được."
    },
    {
      "id": "g3",
      "speaker_id": "SPK_02",
      "start_sec": 290,
      "end_sec": 330,
      "text": "Chị thích tầng trung thôi, khoảng tầng 12 đến 20, ban công hướng Đông Nam cho mát."
    },
    {
      "id": "g4",
      "speaker_id": "SPK_02",
      "start_sec": 440,
      "end_sec": 470,
      "text": "Ngân sách thì tối đa 4,2 tỷ em ạ. Chị có sẵn khoảng 2,1 tỷ."
    },
    {
      "id": "g5",
      "speaker_id": "SPK_02",
      "start_sec": 530,
      "end_sec": 560,
      "text": "Còn lại chị định vay một nửa, nhưng cần ân hạn nợ gốc ít nhất 12 tháng."
    },
    {
      "id": "g6",
      "speaker_id": "SPK_01",
      "start_sec": 620,
      "end_sec": 660,
      "text": "Dạ hiện ngân hàng đối tác đang ưu đãi 6,5% trong 18 tháng đầu, sau đó thả nổi theo lãi cơ sở cộng biên độ."
    },
    {
      "id": "g7",
      "speaker_id": "SPK_03",
      "start_sec": 700,
      "end_sec": 740,
      "text": "Em nghe bên đồng nghiệp nói phí quản lý chỗ này hơi cao so với mặt bằng chung."
    },
    {
      "id": "g8",
      "speaker_id": "SPK_02",
      "start_sec": 810,
      "end_sec": 850,
      "text": "Nói thật là giá này cao hơn bên Imperia khoảng 300 triệu em ạ."
    },
    {
      "id": "g9",
      "speaker_id": "SPK_02",
      "start_sec": 900,
      "end_sec": 940,
      "text": "Chị lo nhất là sau 18 tháng lãi suất tăng lên thì áp lực trả nợ lớn."
    },
    {
      "id": "g10",
      "speaker_id": "SPK_01",
      "start_sec": 1140,
      "end_sec": 1190,
      "text": "Em giới thiệu chị căn 18.06, hai phòng ngủ, 72 mét vuông, ban công đúng hướng Đông Nam chị muốn."
    },
    {
      "id": "g11",
      "speaker_id": "SPK_02",
      "start_sec": 1370,
      "end_sec": 1410,
      "text": "Bếp tách riêng chị thích. Có điều phòng ngủ phụ hơi nhỏ."
    },
    {
      "id": "g12",
      "speaker_id": "SPK_01",
      "start_sec": 1590,
      "end_sec": 1630,
      "text": "Bên em giữ căn 18.06 cho chị đến hết thứ Bảy 16/11 nhé."
    },
    {
      "id": "g13",
      "speaker_id": "SPK_02",
      "start_sec": 1780,
      "end_sec": 1820,
      "text": "Chị phải để anh nhà xem đã rồi mới quyết được."
    },
    {
      "id": "g14",
      "speaker_id": "SPK_01",
      "start_sec": 1970,
      "end_sec": 2000,
      "text": "Em gửi chị bảng tính trước tối mai nhé, có cả phương án vay 50%."
    },
    {
      "id": "g15",
      "speaker_id": "SPK_02",
      "start_sec": 2200,
      "end_sec": 2240,
      "text": "Để chị hỏi anh nhà xem hôm nào rảnh rồi chị báo em."
    },
    {
      "id": "g16",
      "speaker_id": "SPK_01",
      "start_sec": 2390,
      "end_sec": 2430,
      "text": "Em xin anh Tuấn chính sách chiết khấu cho chị nếu mình thanh toán nhanh."
    }
  ],
