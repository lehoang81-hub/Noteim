    "tag": "decided",
    "bullets": [
     {
      "id": "b1",
      "text": "Cần căn 2 phòng ngủ cho gia đình 4 người, hai con đang học cấp 1",
      "timestamp_sec": 95,
      "speaker_id": "SPK_02",
      "is_quote": false,
      "edited": false,
      "note_ids": []
     },
     {
      "id": "b2",
      "text": "Ưu tiên gần trường Lê Văn Tám, đi bộ được",
      "timestamp_sec": 125,
      "speaker_id": "SPK_02",
      "is_quote": false,
      "edited": false,
      "note_ids": []
     },
     {
      "id": "b3",
      "text": "Muốn tầng trung, từ tầng 12 đến 20, ban công hướng Đông Nam",
      "timestamp_sec": 310,
      "speaker_id": "SPK_02",
      "is_quote": false,
      "edited": false,
      "note_ids": []
     }
    ]
   },
   {
    "id": "t2",
    "section_id": "tpl-realestate-s2",
    "title": "Ngân sách và phương án vay",
    "start_sec": 420,
    "end_sec": 780,
    "tag": "figure",
    "bullets": [
     {
      "id": "b4",
      "text": "Ngân sách tối đa 4,2 tỷ, đã có sẵn khoảng 2,1 tỷ",
      "timestamp_sec": 450,
      "speaker_id": "SPK_02",
      "is_quote": false,
      "edited": false,
      "note_ids": []
     },
     {
      "id": "b5",
      "text": "Dự kiến vay 50%, cần ân hạn nợ gốc ít nhất 12 tháng",
      "timestamp_sec": 540,
      "speaker_id": "SPK_02",
      "is_quote": false,
      "edited": false,
      "note_ids": []
     },
     {
      "id": "b6",
      "text": "Lãi suất ưu đãi 6,5% trong 18 tháng, sau đó thả nổi",
      "timestamp_sec": 630,
      "speaker_id": "SPK_01",
      "is_quote": false,
      "edited": false,
      "note_ids": []
     }
    ]
   },
