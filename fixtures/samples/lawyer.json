   "start_sec": 14,
   "end_sec": 23,
   "text": "Điều khoản chốt giá trong hợp đồng viết thế nào, ông đọc giúp em?",
   "lang": "vi",
   "translations": {},
   "edited": false,
   "text_clean": "Điều khoản chốt giá trong hợp đồng viết thế nào, ông đọc giúp em?"
